PORT=3000
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=
MONGODB_URI=
# Leave blank for sample-data mode. Add your MongoDB Atlas URI to store survey responses.

# Public HTTPS origin; leave blank until deployed. Enables sitemap and canonical URLs.
SITE_URL=
GOOGLE_SITE_VERIFICATION=
# Optional GA4 ID. Visitors must allow analytics before it loads.
GA_MEASUREMENT_ID=
# Hosted signup page and WhatsApp Channel URL (HTTPS only).
NEWSLETTER_URL=
WHATSAPP_CHANNEL_URL=

# Checks current political source headlines once per Nairobi calendar day.
DAILY_ANALYSIS_ENABLED=true
